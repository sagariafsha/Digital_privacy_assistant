    // ============================================================
    // APP RISK ENGINE
    // ============================================================

    private static int calculateAppRisk(
            String camera,
            String microphone,
            String location,
            String contacts,
            String storage,
            String notification,
            String usageStatus) {

        int score = 10;

        if ("GRANTED".equals(camera)) {
            score += 12;
        }

        if ("GRANTED".equals(microphone)) {
            score += 12;
        }

        if ("GRANTED".equals(location)) {
            score += 15;
        }

        if ("GRANTED".equals(contacts)) {
            score += 15;
        }

        if ("GRANTED".equals(storage)) {
            score += 10;
        }

        if ("GRANTED".equals(notification)) {
            score += 8;
        }

        if ("UNUSED".equalsIgnoreCase(
                usageStatus)) {

            score += 15;
        }

        return clamp(score, 0, 100);
    }

    private static int countGrantedSensitivePermissions(
            String... permissions) {

        int count = 0;

        for (String permission :
                permissions) {

            if ("GRANTED".equals(permission)) {
                count++;
            }
        }

        return count;
    }

    private static String appRiskExplanation(
            String camera,
            String microphone,
            String location,
            String contacts,
            String storage,
            String notification,
            String usageStatus,
            int score) {

        List<String> reasons =
                new ArrayList<>();

        if ("GRANTED".equals(location)) {
            reasons.add(
                    "Location permission is granted."
            );
        }

        if ("GRANTED".equals(camera)) {
            reasons.add(
                    "Camera permission is granted."
            );
        }

        if ("GRANTED".equals(microphone)) {
            reasons.add(
                    "Microphone permission is granted."
            );
        }

        if ("GRANTED".equals(contacts)) {
            reasons.add(
                    "Contacts permission is granted."
            );
        }

        if ("GRANTED".equals(storage)) {
            reasons.add(
                    "Storage/media access is granted."
            );
        }

        if ("UNUSED".equalsIgnoreCase(
                usageStatus)) {

            reasons.add(
                    "Android reported the app as potentially unused."
            );
        }

        if (reasons.isEmpty()) {

            return "No high-impact risk factor was verified."
                    + " Score is based only on available Android data.";
        }

        return String.join(
                " ",
                reasons
        ) + " Risk score: " + score + "/100.";
    }

    // ============================================================
    // PERMISSION ANALYSIS
    // ============================================================

    private static void permissionAnalysis(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            int camera = countPermission(
                    email,
                    "CAMERA"
            );

            int microphone = countPermission(
                    email,
                    "MICROPHONE"
            );

            int location = countPermission(
                    email,
                    "LOCATION"
            );

            int contacts = countPermission(
                    email,
                    "CONTACTS"
            );

            int storage = countPermission(
                    email,
                    "STORAGE"
            );

            int notification = countPermission(
                    email,
                    "NOTIFICATION"
            );

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"camera\":"
                            + camera
                            + ",\"microphone\":"
                            + microphone
                            + ",\"location\":"
                            + location
                            + ",\"contacts\":"
                            + contacts
                            + ",\"storage\":"
                            + storage
                            + ",\"notification\":"
                            + notification
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static int countPermission(
            String email,
            String permission)
            throws SQLException {

        String sql = """
            SELECT COUNT(*)
            FROM permission_snapshots
            WHERE email=?
              AND permission_name=?
              AND permission_state='GRANTED'
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, permission);

            try (ResultSet rs =
                         ps.executeQuery()) {

                if (rs.next()) {
                    return rs.getInt(1);
                }
            }
        }

        return 0;
    }

    // ============================================================
    // RISK EXPLANATION
    // ============================================================

    private static void riskExplanation(
            HttpExchange exchange)
            throws IOException {

        try {

            String type =
                    queryParam(
                            exchange,
                            "type"
                    );

            String id =
                    queryParam(
                            exchange,
                            "id"
                    );

            if ("account".equalsIgnoreCase(type)) {

                String sql = """
                    SELECT service,risk_score,risk_level,
                           why_risky,recommendation,
                           potentially_unused,
                           security_signal,
                           personal_data_signal
                    FROM discovered_accounts
                    WHERE id=?
                """;

                try (Connection conn = getConnection();
                     PreparedStatement ps =
                             conn.prepareStatement(sql)) {

                    ps.setInt(
                            1,
                            Integer.parseInt(id)
                    );

                    try (ResultSet rs =
                                 ps.executeQuery()) {

                        if (rs.next()) {

                            sendJson(
                                    exchange,
                                    200,
                                    "{"
                                            + "\"type\":\"ACCOUNT\","
                                            + "\"service\":"
                                            + quote(
                                            rs.getString(
                                                    "service"
                                            )
                                    )
                                            + ",\"score\":"
                                            + rs.getInt(
                                            "risk_score"
                                    )
                                            + ",\"riskLevel\":"
                                            + quote(
                                            rs.getString(
                                                    "risk_level"
                                            )
                                    )
                                            + ",\"why\":"
                                            + quote(
                                            rs.getString(
                                                    "why_risky"
                                            )
                                    )
                                            + ",\"recommendation\":"
                                            + quote(
                                            rs.getString(
                                                    "recommendation"
                                            )
                                    )
                                            + ",\"unused\":"
                                            + rs.getBoolean(
                                            "potentially_unused"
                                    )
                                            + ",\"securitySignal\":"
                                            + rs.getBoolean(
                                            "security_signal"
                                    )
                                            + ",\"personalDataSignal\":"
                                            + rs.getBoolean(
                                            "personal_data_signal"
                                    )
                                            + "}"
                            );

                            return;
                        }
                    }
                }
            }

            sendJson(
                    exchange,
                    404,
                    jsonError("Risk item not found.")
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // RISK SIMULATION
    // ============================================================

    private static void riskSimulation(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            String packageName =
                    queryParam(
                            exchange,
                            "packageName"
                    );

            String removePermission =
                    queryParam(
                            exchange,
                            "removePermission"
                    )
                            .toUpperCase();

            if (email.isBlank()
                    || packageName.isBlank()) {

                sendJson(
                        exchange,
                        400,
                        jsonError(
                                "email and packageName required."
                        )
                );

                return;
            }

            String sql = """
                SELECT *
                FROM device_apps
                WHERE email=? AND package_name=?
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);
                ps.setString(2, packageName);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    if (!rs.next()) {

                        sendJson(
                                exchange,
                                404,
                                jsonError(
                                        "App not found."
                                )
                        );

                        return;
                    }

                    String camera =
                            rs.getString(
                                    "camera_permission"
                            );

                    String microphone =
                            rs.getString(
                                    "microphone_permission"
                            );

                    String location =
                            rs.getString(
                                    "location_permission"
                            );

                    String contacts =
                            rs.getString(
                                    "contacts_permission"
                            );

                    String storage =
                            rs.getString(
                                    "storage_permission"
                            );

                    String notification =
                            rs.getString(
                                    "notification_access"
                            );

                    String usage =
                            rs.getString(
                                    "usage_status"
                            );

                    int current =
                            calculateAppRisk(
                                    camera,
                                    microphone,
                                    location,
                                    contacts,
                                    storage,
                                    notification,
                                    usage
                            );

                    if ("CAMERA".equals(
                            removePermission)) {
                        camera = "DENIED";
                    }

                    if ("MICROPHONE".equals(
                            removePermission)) {
                        microphone = "DENIED";
                    }

                    if ("LOCATION".equals(
                            removePermission)) {
                        location = "DENIED";
                    }

                    if ("CONTACTS".equals(
                            removePermission)) {
                        contacts = "DENIED";
                    }

                    if ("STORAGE".equals(
                            removePermission)) {
                        storage = "DENIED";
                    }

                    if ("NOTIFICATION".equals(
                            removePermission)) {
                        notification = "DENIED";
                    }

                    int simulated =
                            calculateAppRisk(
                                    camera,
                                    microphone,
                                    location,
                                    contacts,
                                    storage,
                                    notification,
                                    usage
                            );

                    sendJson(
                            exchange,
                            200,
                            "{"
                                    + "\"currentScore\":"
                                    + current
                                    + ",\"simulatedScore\":"
                                    + simulated
                                    + ",\"change\":"
                                    + (simulated - current)
                                    + ",\"permission\":"
                                    + quote(removePermission)
                                    + "}"
                    );

                    return;
                }
            }

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // PRIVACY HEALTH
    // ============================================================

    private static void privacyHealth(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            int accountScore =
                    calculateAccountSecurityScore(
                            email
                    );

            int permissionScore =
                    calculatePermissionScore(
                            email
                    );

            int exposureScore =
                    calculateExposureScore(
                            email
                    );

            int unusedScore =
                    calculateUnusedScore(
                            email
                    );

            int securityScore =
                    calculateSecurityScore(
                            email
                    );

            int overall =
                    (
                            accountScore
                                    + permissionScore
                                    + exposureScore
                                    + unusedScore
                                    + securityScore
                    ) / 5;

            String previous =
                    getPreviousScore(email);

            String grade =
                    privacyGrade(overall);

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"privacyScore\":"
                            + overall
                            + ",\"accountSecurityScore\":"
                            + accountScore
                            + ",\"appPermissionScore\":"
                            + permissionScore
                            + ",\"personalDataExposureScore\":"
                            + exposureScore
                            + ",\"unusedAccountScore\":"
                            + unusedScore
                            + ",\"securitySignalScore\":"
                            + securityScore
                            + ",\"previousScore\":"
                            + previous
                            + ",\"grade\":"
                            + quote(grade)
                            + ",\"riskLevel\":"
                            + quote(
                            privacyRiskFromPrivacyScore(
                                    overall
                            )
                    )
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static int calculateAccountSecurityScore(
            String email)
            throws SQLException {

        String sql = """
            SELECT COALESCE(AVG(risk_score),0)
            FROM discovered_accounts
            WHERE email=?
        """;

        int risk = queryInt(sql, email);

        return clamp(
                100 - risk,
                0,
                100
        );
    }

    private static int calculatePermissionScore(
            String email)
            throws SQLException {

        String sql = """
            SELECT COALESCE(AVG(risk_score),0)
            FROM device_apps
            WHERE email=?
        """;

        int risk = queryInt(sql, email);

        return clamp(
                100 - risk,
                0,
                100
        );
    }

    private static int calculateExposureScore(
            String email)
            throws SQLException {

        int services =
                queryInt(
                        """
                        SELECT COUNT(*)
                        FROM discovered_accounts
                        WHERE email=?
                          AND personal_data_signal=1
                        """,
                        email
                );

        return clamp(
                100 - services * 8,
                0,
                100
        );
    }

    private static int calculateUnusedScore(
            String email)
            throws SQLException {

        int unused =
                queryInt(
                        """
                        SELECT COUNT(*)
                        FROM discovered_accounts
                        WHERE email=?
                          AND potentially_unused=1
                        """,
                        email
                );

        return clamp(
                100 - unused * 10,
                0,
                100
        );
    }

    private static int calculateSecurityScore(
            String email)
            throws SQLException {

        int signals =
                queryInt(
                        """
                        SELECT COUNT(*)
                        FROM discovered_accounts
                        WHERE email=?
                          AND security_signal=1
                        """,
                        email
                );

        return clamp(
                100 - signals * 15,
                0,
                100
        );
    }

    private static int getPreviousScore(
            String email)
            throws SQLException {

        String sql = """
            SELECT privacy_score
            FROM privacy_audits
            WHERE email=?
            ORDER BY created_at DESC
            LIMIT 2
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);

            try (ResultSet rs =
                         ps.executeQuery()) {

                if (rs.next()) {

                    int latest =
                            rs.getInt(
                                    "privacy_score"
                            );

                    if (rs.next()) {
                        return rs.getInt(
                                "privacy_score"
                        );
                    }

                    return latest;
                }
            }
        }

        return 0;
    }

    private static void scoreChange(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            String sql = """
                SELECT privacy_score,created_at
                FROM privacy_audits
                WHERE email=?
                ORDER BY created_at DESC
                LIMIT 2
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    int current = 0;
                    int previous = 0;
                    String time = "";

                    if (rs.next()) {
                        current =
                                rs.getInt(
                                        "privacy_score"
                                );
                        time =
                                String.valueOf(
                                        rs.getTimestamp(
                                                "created_at"
                                        )
                                );
                    }

                    if (rs.next()) {
                        previous =
                                rs.getInt(
                                        "privacy_score"
                                );
                    }

                    int change =
                            current - previous;

                    sendJson(
                            exchange,
                            200,
                            "{"
                                    + "\"current\":"
                                    + current
                                    + ",\"previous\":"
                                    + previous
                                    + ",\"change\":"
                                    + change
                                    + ",\"why\":"
                                    + quote(
                                    changeReason(change)
                            )
                                    + ",\"lastScan\":"
                                    + quote(time)
                                    + "}"
                    );
                }
            }

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }
        // ============================================================
    // EXPOSURE CENTER
    // ============================================================

    private static void exposureSummary(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            int emailExposure =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM discovered_accounts
                            WHERE email=?
                            """,
                            email
                    );

            int phoneExposure =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM discovered_accounts
                            WHERE email=?
                              AND personal_data_signal=1
                            """,
                            email
                    );

            int nameExposure =
                    phoneExposure;

            int addressExposure =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM discovered_accounts
                            WHERE email=?
                              AND service IN
                              ('Amazon','Flipkart','Swiggy','Zomato','PayPal')
                            """,
                            email
                    );

            int locationExposure =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM device_apps
                            WHERE email=?
                              AND location_permission='GRANTED'
                            """,
                            email
                    );

            int total =
                    emailExposure
                            + phoneExposure
                            + nameExposure
                            + addressExposure
                            + locationExposure;

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"emailExposure\":"
                            + emailExposure
                            + ",\"phoneExposure\":"
                            + phoneExposure
                            + ",\"nameExposure\":"
                            + nameExposure
                            + ",\"addressExposure\":"
                            + addressExposure
                            + ",\"locationExposure\":"
                            + locationExposure
                            + ",\"totalExposureCount\":"
                            + total
                            + ",\"source\":\"AUTHORIZED_GMAIL_AND_ANDROID_DATA\""
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // SECURITY CENTER
    // ============================================================

    private static void securityCenter(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            StringBuilder json =
                    new StringBuilder();

            json.append("{");

            int securitySignals =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM discovered_accounts
                            WHERE email=?
                              AND security_signal=1
                            """,
                            email
                    );

            int high =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM discovered_accounts
                            WHERE email=?
                              AND security_signal=1
                              AND risk_level='HIGH'
                            """,
                            email
                    );

            json.append(
                    "\"securitySignals\":"
            ).append(securitySignals);

            json.append(
                    ",\"highAlerts\":"
            ).append(high);

            json.append(
                    ",\"verifiedStatement\":"
            ).append(
                    quote(
                            "Security signals are evidence from authorized Gmail messages. "
                                    + "They do not prove that an account was hacked."
                    )
            );

            json.append(
                    ",\"guidance\":"
            ).append(
                    quote(
                            "Review the affected service, change the password if needed, "
                                    + "enable multi-factor authentication, and check the "
                                    + "service's official security page."
                    )
            );

            json.append("}");

            sendJson(
                    exchange,
                    200,
                    json.toString()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // TIMELINE
    // ============================================================

    private static void privacyTimeline(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            StringBuilder json =
                    new StringBuilder("[");

            String sql = """
                SELECT *
                FROM privacy_timeline
                WHERE email=?
                ORDER BY created_at DESC
                LIMIT 200
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    boolean first = true;

                    while (rs.next()) {

                        if (!first) {
                            json.append(",");
                        }

                        first = false;

                        json.append("{")
                                .append("\"eventType\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "event_type"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"service\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "service"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"description\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "description"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"eventDate\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "event_date"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"source\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "source"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"createdAt\":")
                                .append(
                                        quote(
                                                String.valueOf(
                                                        rs.getTimestamp(
                                                                "created_at"
                                                        )
                                                )
                                        )
                                )
                                .append("}");
                    }
                }
            }

            json.append("]");

            sendJson(
                    exchange,
                    200,
                    json.toString()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static void addTimelineEvent(
            String email,
            String type,
            String service,
            String description,
            String eventDate,
            String source) {

        String sql = """
            INSERT INTO privacy_timeline
            (email,event_type,service,description,event_date,source)
            VALUES (?,?,?,?,?,?)
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, type);
            ps.setString(3, service);
            ps.setString(4, description);
            ps.setString(5, eventDate);
            ps.setString(6, source);

            ps.executeUpdate();

        } catch (Exception ignored) {
        }
    }


    private static class ServiceSignal {

        String service;
        String domain;

        int evidenceCount = 0;

        String firstDetected;
        String lastDetected;

        boolean potentiallyUnused;
        boolean securitySignal;
        boolean personalDataSignal;

        int riskScore;

        String riskLevel;

        String recommendation;

        String whyRisky;

        ServiceSignal(
                String service,
                String domain) {

            this.service = service;
            this.domain = domain;
        }
    }

    private static class DiscoverySummary {

        String email;

        int totalAccounts;
        int highRisk;
        int mediumRisk;
        int lowRisk;
        int unusedAccounts;

        int securitySignals;
        int personalDataSignals;

        int privacyScore;

        String riskLevel;

        DiscoverySummary(
                String email,
                int totalAccounts,
                int highRisk,
                int mediumRisk,
                int lowRisk,
                int unusedAccounts,
                int securitySignals,
                int personalDataSignals,
                int privacyScore,
                String riskLevel) {

            this.email = email;
            this.totalAccounts = totalAccounts;
            this.highRisk = highRisk;
            this.mediumRisk = mediumRisk;
            this.lowRisk = lowRisk;
            this.unusedAccounts = unusedAccounts;
            this.securitySignals = securitySignals;
            this.personalDataSignals = personalDataSignals;
            this.privacyScore = privacyScore;
            this.riskLevel = riskLevel;
        }

        String toJson() {

            return "{"
                    + "\"email\":"
                    + quote(email)
                    + ",\"totalAccounts\":"
                    + totalAccounts
                    + ",\"highRisk\":"
                    + highRisk
                    + ",\"mediumRisk\":"
                    + mediumRisk
                    + ",\"lowRisk\":"
                    + lowRisk
                    + ",\"unusedAccounts\":"
                    + unusedAccounts
                    + ",\"securitySignals\":"
                    + securitySignals
                    + ",\"personalDataSignals\":"
                    + personalDataSignals
                    + ",\"privacyScore\":"
                    + privacyScore
                    + ",\"riskLevel\":"
                    + quote(riskLevel)
                    + "}";
        }
    }

    private static class WebsiteScanResult {

        String website;
        String httpsStatus;
        String certificateStatus;
        String cookieIndicator;
        String thirdPartyIndicator;
        String trackerIndicator;
        String riskLevel;
        int riskScore;
        String explanation;

        WebsiteScanResult(
                String website,
                String httpsStatus,
                String certificateStatus,
                String cookieIndicator,
                String thirdPartyIndicator,
                String trackerIndicator,
                String riskLevel,
                int riskScore,
                String explanation) {

            this.website = website;
            this.httpsStatus = httpsStatus;
            this.certificateStatus = certificateStatus;
            this.cookieIndicator = cookieIndicator;
            this.thirdPartyIndicator = thirdPartyIndicator;
            this.trackerIndicator = trackerIndicator;
            this.riskLevel = riskLevel;
            this.riskScore = riskScore;
            this.explanation = explanation;
        }

        String toJson() {

            return "{"
                    + "\"website\":"
                    + quote(website)
                    + ",\"https\":"
                    + quote(httpsStatus)
                    + ",\"certificate\":"
                    + quote(certificateStatus)
                    + ",\"cookies\":"
                    + quote(cookieIndicator)
                    + ",\"thirdPartyResources\":"
                    + quote(thirdPartyIndicator)
                    + ",\"trackers\":"
                    + quote(trackerIndicator)
                    + ",\"privacyRisk\":"
                    + quote(riskLevel)
                    + ",\"riskScore\":"
                    + riskScore
                    + ",\"whyRisky\":"
                    + quote(explanation)
                    + ",\"source\":\"WEBSITE_SCAN\""
                    + "}";
        }
    }

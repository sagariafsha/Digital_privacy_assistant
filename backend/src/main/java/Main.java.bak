    private static void updateDeletionStatus(
            HttpExchange exchange)
            throws IOException {

        try {

            Map<String, String> form =
                    parseForm(exchange);

            String email =
                    form.getOrDefault(
                            "email",
                            getConnectedEmail()
                    );

            String service =
                    form.getOrDefault(
                            "service",
                            ""
                    );

            String status =
                    form.getOrDefault(
                            "status",
                            "REQUESTED"
                    ).toUpperCase();

            String notes =
                    form.getOrDefault(
                            "notes",
                            ""
                    );

            String sql = """
                INSERT INTO privacy_actions
                (email,service,action_type,status,notes)
                VALUES (?,?,?,?,?)
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);
                ps.setString(2, service);
                ps.setString(
                        3,
                        "ACCOUNT_DELETION"
                );
                ps.setString(4, status);
                ps.setString(5, notes);

                ps.executeUpdate();
            }

            addTimelineEvent(
                    email,
                    "DELETION_EVENT",
                    service,
                    "Deletion status changed to " + status,
                    null,
                    "USER_ACTION"
            );

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"success\":true,"
                            + "\"status\":"
                            + quote(status)
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // WEBSITE PRIVACY CHECKER
    // ============================================================

    private static void websiteCheck(
            HttpExchange exchange)
            throws IOException {

        try {

            String website =
                    queryParam(
                            exchange,
                            "url"
                    );

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            if (website.isBlank()) {

                sendJson(
                        exchange,
                        400,
                        jsonError(
                                "Website URL required."
                        )
                );

                return;
            }

            if (!website.startsWith("http://")
                    && !website.startsWith("https://")) {

                website =
                        "https://" + website;
            }

            URI uri =
                    URI.create(website);

            String host =
                    uri.getHost();

            if (host == null || host.isBlank()) {

                sendJson(
                        exchange,
                        400,
                        jsonError(
                                "Invalid website."
                        )
                );

                return;
            }

            boolean https =
                    "https".equalsIgnoreCase(
                            uri.getScheme()
                    );

            int risk = 0;

            List<String> reasons =
                    new ArrayList<>();

            if (!https) {

                risk += 35;

                reasons.add(
                        "The website is not using HTTPS."
                );
            }

            if (host.matches(
                    "\\d+(\\.\\d+){3}"
            )) {

                risk += 20;

                reasons.add(
                        "The URL uses an IP address instead of a normal domain."
                );
            }

            if (host.contains("xn--")) {

                risk += 15;

                reasons.add(
                        "The domain contains punycode."
                );
            }

            if (website.contains("@")) {

                risk += 20;

                reasons.add(
                        "The URL contains an @ character."
                );
            }

            String[] suspiciousWords = {
                    "login",
                    "verify",
                    "account",
                    "secure",
                    "password",
                    "wallet"
            };

            String lower =
                    website.toLowerCase();

            int keywordCount = 0;

            for (String word :
                    suspiciousWords) {

                if (lower.contains(word)) {
                    keywordCount++;
                }
            }

            risk +=
                    Math.min(
                            keywordCount * 5,
                            20
                    );

            WebsiteScanResult scan =
                    performWebsiteInspection(
                            website,
                            risk,
                            reasons
                    );

            saveWebsiteCheck(
                    email,
                    website,
                    scan
            );

            sendJson(
                    exchange,
                    200,
                    scan.toJson()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(
                            "Website scan failed: "
                                    + e.getMessage()
                    )
            );
        }
    }

    private static WebsiteScanResult
    performWebsiteInspection(
            String website,
            int baseRisk,
            List<String> reasons) {

        int risk = baseRisk;

        String httpsStatus =
                website.startsWith("https://")
                        ? "HTTPS"
                        : "HTTP";

        String certificate =
                "UNAVAILABLE";

        String cookies =
                "UNAVAILABLE";

        String thirdParty =
                "UNAVAILABLE";

        String trackers =
                "NOT_VERIFIED";

        try {

            URL url =
                    new URL(website);

            URLConnection raw =
                    url.openConnection();

            raw.setConnectTimeout(5000);
            raw.setReadTimeout(5000);

            if (raw instanceof HttpsURLConnection https) {

                https.connect();

                certificate =
                        "TLS CONNECTION SUCCESSFUL";

                https.disconnect();

            } else {

                raw.connect();
            }

            String cookieHeader =
                    raw.getHeaderField("Set-Cookie");

            if (cookieHeader != null) {

                cookies =
                        "COOKIE_HEADER_PRESENT";

                reasons.add(
                        "The website response included a Set-Cookie header."
                );
            } else {

                cookies =
                        "NO_COOKIE_HEADER_OBSERVED";
            }

            if (raw instanceof HttpURLConnection http) {

                int code =
                        http.getResponseCode();

                if (code >= 400) {

                    reasons.add(
                            "The website returned HTTP status "
                                    + code + "."
                    );

                    risk += 10;
                }

                String contentType =
                        http.getHeaderField(
                                "Content-Type"
                        );

                if (contentType != null
                        && contentType.contains(
                        "text/html"
                )) {

                    thirdParty =
                            "HTML_INSPECTION_AVAILABLE";

                    trackers =
                            "NOT_COUNTED";

                    /*
                     * We deliberately do NOT claim:
                     * "27 trackers detected".
                     *
                     * A real tracker count requires
                     * resource-level analysis.
                     */
                }

                http.disconnect();
            }

        } catch (Exception e) {

            certificate =
                    "UNAVAILABLE";

            cookies =
                    "UNAVAILABLE";

            thirdParty =
                    "UNAVAILABLE";

            reasons.add(
                    "Some website information could not be verified."
            );
        }

        risk =
                clamp(
                        risk,
                        0,
                        100
                );

        String level;

        if (risk >= 70) {
            level = "HIGH";
        } else if (risk >= 40) {
            level = "MEDIUM";
        } else {
            level = "LOW";
        }

        String explanation;

        if (reasons.isEmpty()) {

            explanation =
                    "No high-risk signal was detected by this limited website check.";

        } else {

            explanation =
                    String.join(
                            " ",
                            reasons
                    );
        }

        return new WebsiteScanResult(
                website,
                httpsStatus,
                certificate,
                cookies,
                thirdParty,
                trackers,
                level,
                risk,
                explanation
        );
    }

    private static void saveWebsiteCheck(
            String email,
            String website,
            WebsiteScanResult scan)
            throws SQLException {

        String sql = """
            INSERT INTO website_checks
            (
                email,
                website,
                https_status,
                certificate_status,
                cookie_indicator,
                third_party_indicator,
                tracker_indicator,
                privacy_risk,
                risk_score,
                explanation,
                source
            )
            VALUES (?,?,?,?,?,?,?,?,?,?,?)
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, website);
            ps.setString(3, scan.httpsStatus);
            ps.setString(4, scan.certificateStatus);
            ps.setString(5, scan.cookieIndicator);
            ps.setString(6, scan.thirdPartyIndicator);
            ps.setString(7, scan.trackerIndicator);
            ps.setString(8, scan.riskLevel);
            ps.setInt(9, scan.riskScore);
            ps.setString(10, scan.explanation);
            ps.setString(11, "WEBSITE_SCAN");

            ps.executeUpdate();
        }
    }

    private static void websiteHistory(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            StringBuilder json =
                    new StringBuilder("[");

            String sql = """
                SELECT *
                FROM website_checks
                WHERE email=?
                ORDER BY created_at DESC
                LIMIT 100
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    boolean first = true;

                    while (rs.next()) {

                        if (!first) {
                            json.append(",");
                        }

                        first = false;

                        json.append("{")
                                .append("\"website\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "website"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"risk\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "privacy_risk"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"score\":")
                                .append(
                                        rs.getInt(
                                                "risk_score"
                                        )
                                )
                                .append(",")

                                .append("\"explanation\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "explanation"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"createdAt\":")
                                .append(
                                        quote(
                                                String.valueOf(
                                                        rs.getTimestamp(
                                                                "created_at"
                                                        )
                                                )
                                        )
                                )
                                .append("}");
                    }
                }
            }

            json.append("]");

            sendJson(
                    exchange,
                    200,
                    json.toString()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }


    private static void generateRecommendations(
            String email)
            throws SQLException {

        int highAccounts =
                queryInt(
                        """
                        SELECT COUNT(*)
                        FROM discovered_accounts
                        WHERE email=?
                          AND risk_level='HIGH'
                        """,
                        email
                );

        int unused =
                queryInt(
                        """
                        SELECT COUNT(*)
                        FROM discovered_accounts
                        WHERE email=?
                          AND potentially_unused=1
                        """,
                        email
                );

        int sensitiveApps =
                queryInt(
                        """
                        SELECT COUNT(*)
                        FROM device_apps
                        WHERE email=?
                          AND sensitive_permission_count>=2
                        """,
                        email
                );

        int security =
                queryInt(
                        """
                        SELECT COUNT(*)
                        FROM discovered_accounts
                        WHERE email=?
                          AND security_signal=1
                        """,
                        email
                );

        addRecommendation(
                email,
                "Review high-risk accounts",
                "Review accounts with high risk scores and decide whether to secure or delete them.",
                highAccounts > 0 ? "HIGH" : "LOW",
                "Detected " + highAccounts
                        + " high-risk account(s)."
        );

        addRecommendation(
                email,
                "Review unused accounts",
                "Check accounts with old Gmail evidence and remove accounts you no longer need.",
                unused > 0 ? "MEDIUM" : "LOW",
                "Detected " + unused
                        + " potentially unused account(s)."
        );

        addRecommendation(
                email,
                "Review sensitive permissions",
                "Check apps requesting multiple sensitive permissions.",
                sensitiveApps > 0 ? "HIGH" : "LOW",
                "Detected " + sensitiveApps
                        + " app(s) with multiple sensitive permissions."
        );

        addRecommendation(
                email,
                "Review security signals",
                "Check security alerts, password resets and new-login evidence.",
                security > 0 ? "HIGH" : "LOW",
                "Detected " + security
                        + " security signal(s)."
        );
    }

    private static void addRecommendation(
            String email,
            String title,
            String explanation,
            String priority,
            String reason)
            throws SQLException {

        String sql = """
            INSERT INTO recommendations
            (email,title,explanation,priority,reason)
            VALUES (?,?,?,?,?)
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, title);
            ps.setString(3, explanation);
            ps.setString(4, priority);
            ps.setString(5, reason);

            ps.executeUpdate();
        }
    }

    private static String getRecommendationsJson(
            String email)
            throws SQLException {

        StringBuilder json =
                new StringBuilder("[");

        String sql = """
            SELECT *
            FROM recommendations
            WHERE email=?
            ORDER BY
              CASE priority
                WHEN 'HIGH' THEN 1
                WHEN 'MEDIUM' THEN 2
                ELSE 3
              END,
              created_at DESC
            LIMIT 20
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);

            try (ResultSet rs =
                         ps.executeQuery()) {

                boolean first = true;

                while (rs.next()) {

                    if (!first) {
                        json.append(",");
                    }

                    first = false;

                    json.append("{")
                            .append("\"id\":")
                            .append(
                                    rs.getInt("id")
                            )
                            .append(",")

                            .append("\"title\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "title"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"explanation\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "explanation"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"priority\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "priority"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"why\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "reason"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"status\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "status"
                                            )
                                    )
                            )
                            .append("}");
                }
            }
        }

        json.append("]");

        return json.toString();
    }

    private static void recommendationStatus(
            HttpExchange exchange)
            throws IOException {

        try {

            Map<String, String> form =
                    parseForm(exchange);

            int id =
                    Integer.parseInt(
                            form.getOrDefault(
                                    "id",
                                    "0"
                            )
                    );

            String status =
                    form.getOrDefault(
                            "status",
                            "COMPLETED"
                    );

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(
                                 """
                                 UPDATE recommendations
                                 SET status=?
                                 WHERE id=?
                                 """
                         )) {

                ps.setString(1, status);
                ps.setInt(2, id);

                ps.executeUpdate();
            }

            sendJson(
                    exchange,
                    200,
                    "{\"success\":true}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // UNIVERSAL SEARCH
    // ============================================================

    private static void universalSearch(
            HttpExchange exchange)
            throws IOException {

        try {

            String q =
                    queryParam(
                            exchange,
                            "q"
                    ).toLowerCase();

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            StringBuilder json =
                    new StringBuilder("[");

            boolean first = true;

            // Accounts
            String accountSql = """
                SELECT service,domain,risk_level,risk_score
                FROM discovered_accounts
                WHERE email=?
                  AND (
                    LOWER(service) LIKE ?
                    OR LOWER(domain) LIKE ?
                    OR LOWER(risk_level) LIKE ?
                  )
                LIMIT 30
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(accountSql)) {

                String pattern =
                        "%" + q + "%";

                ps.setString(1, email);
                ps.setString(2, pattern);
                ps.setString(3, pattern);
                ps.setString(4, pattern);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    while (rs.next()) {

                        if (!first) {
                            json.append(",");
                        }

                        first = false;

                        json.append("{")
                                .append("\"type\":\"ACCOUNT\",")
                                .append("\"name\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "service"
                                                )
                                        )
                                )
                                .append(",\"risk\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "risk_level"
                                                )
                                        )
                                )
                                .append(",\"score\":")
                                .append(
                                        rs.getInt(
                                                "risk_score"
                                        )
                                )
                                .append("}");
                    }
                }
            }

            // Apps
            String appSql = """
                SELECT app_name,package_name,
                       risk_level,risk_score
                FROM device_apps
                WHERE email=?
                  AND (
                    LOWER(app_name) LIKE ?
                    OR LOWER(package_name) LIKE ?
                    OR LOWER(risk_level) LIKE ?
                  )
                LIMIT 30
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(appSql)) {

                String pattern =
                        "%" + q + "%";

                ps.setString(1, email);
                ps.setString(2, pattern);
                ps.setString(3, pattern);
                ps.setString(4, pattern);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    while (rs.next()) {

                        if (!first) {
                            json.append(",");
                        }

                        first = false;

                        json.append("{")
                                .append("\"type\":\"APP\",")
                                .append("\"name\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "app_name"
                                                )
                                        )
                                )
                                .append(",\"packageName\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "package_name"
                                                )
                                        )
                                )
                                .append(",\"risk\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "risk_level"
                                                )
                                        )
                                )
                                .append(",\"score\":")
                                .append(
                                        rs.getInt(
                                                "risk_score"
                                        )
                                )
                                .append("}");
                    }
                }
            }

            json.append("]");

            sendJson(
                    exchange,
                    200,
                    json.toString()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }


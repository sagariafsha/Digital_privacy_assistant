                                                "personal_data_signals"
                                        )
                                )
                                .append(",")

                                .append("\"createdAt\":")
                                .append(
                                        quote(
                                                String.valueOf(
                                                        rs.getTimestamp(
                                                                "created_at"
                                                        )
                                                )
                                        )
                                )
                                .append("}");
                    }
                }
            }

            json.append("]");

            sendJson(
                    exchange,
                    200,
                    json.toString()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // SAVE PRIVACY AUDIT
    // ============================================================

    private static void savePrivacyAudit(
            String email,
            int score,
            String riskLevel,
            int messages,
            int securitySignals,
            int personalSignals)
            throws SQLException {

        String sql = """
            INSERT INTO privacy_audits
            (
                email,
                privacy_score,
                risk_level,
                total_messages,
                total_threads,
                security_signals,
                personal_data_signals
            )
            VALUES (?,?,?,?,?,?,?)
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setInt(2, score);
            ps.setString(3, riskLevel);
            ps.setInt(4, messages);
            ps.setInt(5, 0);
            ps.setInt(6, securitySignals);
            ps.setInt(7, personalSignals);

            ps.executeUpdate();
        }
    }

    // ============================================================
    // RISK CALCULATIONS
    // ============================================================

    private static int calculateAccountRisk(
            ServiceSignal s) {

        int risk = 10;

        if (s.potentiallyUnused) {
            risk += 35;
        }

        if (s.securitySignal) {
            risk += 30;
        }

        if (s.personalDataSignal) {
            risk += 15;
        }

        if (s.evidenceCount >= 3) {
            risk += 10;
        }

        if (isVeryOld(s.lastDetected)) {
            risk += 10;
        }

        return clamp(
                risk,
                0,
                100
        );
    }

    private static int calculatePrivacyScore(
            Collection<ServiceSignal> signals) {

        if (signals.isEmpty()) {
            return 100;
        }

        int totalRisk = 0;

        for (ServiceSignal signal :
                signals) {

            totalRisk +=
                    signal.riskScore;
        }

        int average =
                totalRisk / signals.size();

        return clamp(
                100 - average,
                0,
                100
        );
    }

    private static String getRiskLevelFromRisk(
            int score) {

        if (score >= 70) {
            return "HIGH";
        }

        if (score >= 40) {
            return "MEDIUM";
        }

        return "LOW";
    }

    private static String privacyRiskFromPrivacyScore(
            int score) {

        if (score >= 70) {
            return "LOW";
        }

        if (score >= 40) {
            return "MEDIUM";
        }

        return "HIGH";
    }

    private static String privacyGrade(
            int score) {

        if (score >= 90) return "A";
        if (score >= 80) return "B";
        if (score >= 70) return "C";
        if (score >= 60) return "D";
        return "F";
    }

    // ============================================================
    // ACCOUNT EXPLANATIONS
    // ============================================================

    private static String accountRiskExplanation(
            ServiceSignal s) {

        List<String> reasons =
                new ArrayList<>();

        if (s.potentiallyUnused) {

            reasons.add(
                    "Possible inactivity was detected because the latest matching Gmail evidence is old."
            );
        }

        if (s.securitySignal) {

            reasons.add(
                    "Security-related Gmail evidence was detected."
            );
        }

        if (s.personalDataSignal) {

            reasons.add(
                    "Messages suggest the service may be associated with personal-data activity."
            );
        }

        if (s.evidenceCount >= 3) {

            reasons.add(
                    "Multiple Gmail evidence messages were detected."
            );
        }

        if (reasons.isEmpty()) {

            reasons.add(
                    "No major risk factor was detected from the available evidence."
            );
        }

        return String.join(
                " ",
                reasons
        );
    }

    private static String accountRecommendation(
            ServiceSignal s) {

        if (s.securitySignal) {

            return "Review the account security, check recent activity and consider changing the password.";
        }

        if (s.potentiallyUnused) {

            return "Check whether you still need this account. If not, use the official deletion process.";
        }

        if (s.personalDataSignal) {

            return "Review the personal information stored by this service.";
        }

        return "Keep monitoring this account.";
    }


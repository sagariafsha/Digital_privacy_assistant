    private static void watchlistToggle(
            HttpExchange exchange)
            throws IOException {

        try {

            Map<String, String> form =
                    parseForm(exchange);

            String email =
                    form.getOrDefault(
                            "email",
                            getConnectedEmail()
                    );

            String type =
                    form.getOrDefault(
                            "type",
                            "ACCOUNT"
                    );

            String key =
                    form.getOrDefault(
                            "key",
                            ""
                    );

            String name =
                    form.getOrDefault(
                            "name",
                            key
                    );

            boolean watch =
                    Boolean.parseBoolean(
                            form.getOrDefault(
                                    "watch",
                                    "true"
                            )
                    );

            if (watch) {

                String sql = """
                    INSERT IGNORE INTO watchlist
                    (email,item_type,item_key,item_name)
                    VALUES (?,?,?,?)
                """;

                try (Connection conn = getConnection();
                     PreparedStatement ps =
                             conn.prepareStatement(sql)) {

                    ps.setString(1, email);
                    ps.setString(2, type);
                    ps.setString(3, key);
                    ps.setString(4, name);

                    ps.executeUpdate();
                }

            } else {

                String sql = """
                    DELETE FROM watchlist
                    WHERE email=?
                      AND item_type=?
                      AND item_key=?
                """;

                try (Connection conn = getConnection();
                     PreparedStatement ps =
                             conn.prepareStatement(sql)) {

                    ps.setString(1, email);
                    ps.setString(2, type);
                    ps.setString(3, key);

                    ps.executeUpdate();
                }
            }

            sendJson(
                    exchange,
                    200,
                    "{\"success\":true}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // PRIVACY MODE
    // ============================================================

    private static void privacyMode(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            int critical =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM discovered_accounts
                            WHERE email=?
                              AND risk_level='HIGH'
                              AND security_signal=1
                            """,
                            email
                    );

            int accounts =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM discovered_accounts
                            WHERE email=?
                              AND risk_level='HIGH'
                            """,
                            email
                    );

            int permissions =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM device_apps
                            WHERE email=?
                              AND sensitive_permission_count>0
                            """,
                            email
                    );

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"title\":\"TODAY'S PRIVACY\","
                            + "\"criticalAlerts\":"
                            + critical
                            + ",\"accountsNeedReview\":"
                            + accounts
                            + ",\"sensitivePermissions\":"
                            + permissions
                            + ",\"verifiedOnly\":true"
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // CLEANUP JOURNEY
    // ============================================================

    private static void cleanup(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            ensureCleanupRow(email);

            String sql = """
                SELECT *
                FROM cleanup_progress
                WHERE email=?
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    if (rs.next()) {

                        sendJson(
                                exchange,
                                200,
                                "{"
                                        + "\"step1Accounts\":"
                                        + rs.getBoolean(
                                        "step1_accounts"
                                )
                                        + ",\"step2Permissions\":"
                                        + rs.getBoolean(
                                        "step2_permissions"
                                )
                                        + ",\"step3Exposure\":"
                                        + rs.getBoolean(
                                        "step3_exposure"
                                )
                                        + ",\"step4Websites\":"
                                        + rs.getBoolean(
                                        "step4_websites"
                                )
                                        + ",\"step5Deletion\":"
                                        + rs.getBoolean(
                                        "step5_deletion"
                                )
                                        + "}"
                        );

                        return;
                    }
                }
            }

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static void ensureCleanupRow(
            String email)
            throws SQLException {

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(
                             """
                             INSERT IGNORE INTO cleanup_progress(email)
                             VALUES (?)
                             """
                     )) {

            ps.setString(1, email);
            ps.executeUpdate();
        }
    }

    // ============================================================
    // PRIVACY GOALS
    // ============================================================

    private static void privacyGoal(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            String goal =
                    queryParam(
                            exchange,
                            "goal"
                    );

            if (!goal.isBlank()) {

                int target =
                        Integer.parseInt(goal);

                String sql = """
                    INSERT INTO privacy_goals
                    (email,goal_score)
                    VALUES (?,?)
                    ON DUPLICATE KEY UPDATE
                    goal_score=VALUES(goal_score),
                    status='ACTIVE'
                """;

                try (Connection conn = getConnection();
                     PreparedStatement ps =
                             conn.prepareStatement(sql)) {

                    ps.setString(1, email);
                    ps.setInt(2, target);

                    ps.executeUpdate();
                }
            }

            int current =
                    calculateCurrentOverallScore(
                            email
                    );

            int target =
                    queryInt(
                            """
                            SELECT goal_score
                            FROM privacy_goals
                            WHERE email=?
                            """,
                            email
                    );

            if (target == 0) {
                target = 85;
            }

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"current\":"
                            + current
                            + ",\"target\":"
                            + target
                            + ",\"remaining\":"
                            + Math.max(
                            0,
                            target - current
                    )
                            + ",\"message\":"
                            + quote(
                            current >= target
                                    ? "Privacy goal reached."
                                    : "Review the recommended actions to improve your privacy posture."
                    )
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // ACHIEVEMENTS
    // ============================================================

    private static void achievements(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            updateAchievementsAfterScan(
                    email,
                    calculateCurrentOverallScore(email)
            );

            StringBuilder json =
                    new StringBuilder("[");

            String sql = """
                SELECT *
                FROM achievements
                WHERE email=?
                ORDER BY id
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    boolean first = true;

                    while (rs.next()) {

                        if (!first) {
                            json.append(",");
                        }

                        first = false;

                        json.append("{")
                                .append("\"key\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "achievement_key"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"title\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "title"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"description\":")
                                .append(
                                        quote(
                                                rs.getString(
                                                        "description"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"unlocked\":")
                                .append(
                                        rs.getBoolean(
                                                "unlocked"
                                        )
                                )
                                .append("}");
                    }
                }
            }

            json.append("]");

            sendJson(
                    exchange,
                    200,
                    json.toString()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static void updateAchievementsAfterScan(
            String email,
            int score) {

        try {

            createAchievement(
                    email,
                    "FIRST_SCAN",
                    "First Privacy Scan",
                    "Completed your first privacy scan.",
                    true
            );

            int completed =
                    queryInt(
                            """
                            SELECT COUNT(*)
                            FROM privacy_actions
                            WHERE email=?
                              AND status='COMPLETED'
                            """,
                            email
                    );

            createAchievement(
                    email,
                    "FIRST_DELETION",
                    "Completed First Deletion Request",
                    "Completed a deletion action.",
                    completed > 0
            );

            createAchievement(
                    email,
                    "IMPROVED_SCORE",
                    "Improved Privacy Score",
                    "Your privacy score improved compared with an earlier scan.",
                    hasScoreImproved(email)
            );

        } catch (Exception ignored) {
        }
    }

    private static void createAchievement(
            String email,
            String key,
            String title,
            String description,
            boolean unlocked)
            throws SQLException {

        String sql = """
            INSERT INTO achievements
            (email,achievement_key,title,description,unlocked)
            VALUES (?,?,?,?,?)
            ON DUPLICATE KEY UPDATE
            unlocked=GREATEST(unlocked,VALUES(unlocked))
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, key);
            ps.setString(3, title);
            ps.setString(4, description);
            ps.setBoolean(5, unlocked);

            ps.executeUpdate();
        }
    }


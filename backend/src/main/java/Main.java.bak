    private static void deleteRequest(
            HttpExchange exchange)
            throws IOException {

        try {

            String service =
                    queryParam(
                            exchange,
                            "service"
                    );

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            String request =
                    """
                    Subject: Request for Deletion of Personal Data

                    Dear %s Privacy Team,

                    I would like to request deletion of my account and
                    personal data associated with my account, subject to
                    applicable legal and contractual requirements.

                    Account email:
                    %s

                    Please confirm receipt of this request and let me know
                    if any additional verification is required.

                    Thank you.
                    """.formatted(
                            service,
                            email
                    );

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"service\":"
                            + quote(service)
                            + ",\"request\":"
                            + quote(request)
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }


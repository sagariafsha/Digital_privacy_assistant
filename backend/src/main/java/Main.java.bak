    // ============================================================
    // EXISTING SCAN API
    // ============================================================

    private static void scan(
            HttpExchange exchange)
            throws IOException {

        try {

            Map<String, String> form =
                    parseForm(exchange);

            String email =
                    form.getOrDefault(
                            "email",
                            ""
                    ).trim();

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            if (email.isBlank()) {

                sendJson(
                        exchange,
                        400,
                        jsonError(
                                "Email is required."
                        )
                );

                return;
            }

            DiscoverySummary result =
                    discoverAccounts(email);

            sendJson(
                    exchange,
                    200,
                    result.toJson()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }


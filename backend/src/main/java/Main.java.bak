    // ============================================================

    private static String identifyService(
            String domain) {

        String d =
                domain.toLowerCase();

        Map<String, String> known =
                new LinkedHashMap<>();

        known.put(
                "amazon.",
                "Amazon"
        );

        known.put(
                "spotify.",
                "Spotify"
        );

        known.put(
                "facebook.",
                "Facebook"
        );

        known.put(
                "instagram.",
                "Instagram"
        );

        known.put(
                "google.",
                "Google"
        );

        known.put(
                "microsoft.",
                "Microsoft"
        );

        known.put(
                "linkedin.",
                "LinkedIn"
        );

        known.put(
                "discord.",
                "Discord"
        );

        known.put(
                "reddit.",
                "Reddit"
        );

        known.put(
                "dropbox.",
                "Dropbox"
        );

        known.put(
                "adobe.",
                "Adobe"
        );

        known.put(
                "github.",
                "GitHub"
        );

        known.put(
                "twitter.",
                "X / Twitter"
        );

        known.put(
                "x.com",
                "X / Twitter"
        );

        known.put(
                "tiktok.",
                "TikTok"
        );

        known.put(
                "telegram.",
                "Telegram"
        );

        known.put(
                "zoom.",
                "Zoom"
        );

        known.put(
                "canva.",
                "Canva"
        );

        known.put(
                "netflix.",
                "Netflix"
        );

        known.put(
                "paypal.",
                "PayPal"
        );

        known.put(
                "flipkart.",
                "Flipkart"
        );

        known.put(
                "swiggy.",
                "Swiggy"
        );

        known.put(
                "zomato.",
                "Zomato"
        );

        for (Map.Entry<String, String> entry :
                known.entrySet()) {

            if (d.contains(entry.getKey())) {
                return entry.getValue();
            }
        }

        return domain;
    }

    private static String extractDomain(
            String from) {

        if (from == null) {
            return "";
        }

        Matcher matcher =
                Pattern.compile(
                        "@([A-Za-z0-9.-]+)"
                ).matcher(from);

        if (matcher.find()) {

            return matcher.group(1)
                    .toLowerCase();
        }

        return "";
    }

    private static boolean isGenericDomain(
            String domain) {

        String d =
                domain.toLowerCase();

        String[] generic = {
                "google.com",
                "gmail.com",
                "googleusercontent.com",
                "mailchimp.com",
                "sendgrid.net",
                "amazonses.com",
                "cloudflare.com",
                "notifications.google.com"
        };

        for (String g : generic) {

            if (d.equals(g)
                    || d.endsWith("." + g)) {

                return true;
            }
        }

        return false;
    }

    // ============================================================
    // DATE / INACTIVITY
    // ============================================================

    private static boolean isPotentiallyUnused(
            String date) {

        if (date == null
                || date.isBlank()) {

            return false;
        }

        try {

            Instant detected =
                    parseEmailDate(date);

            return detected.isBefore(
                    Instant.now().minus(
                            Duration.ofDays(365)
                    )
            );

        } catch (Exception e) {

            return false;
        }
    }

    private static boolean isVeryOld(
            String date) {

        if (date == null
                || date.isBlank()) {

            return false;
        }

        try {

            Instant detected =
                    parseEmailDate(date);

            return detected.isBefore(
                    Instant.now().minus(
                            Duration.ofDays(730)
                    )
            );

        } catch (Exception e) {

            return false;
        }
    }

    private static Instant parseEmailDate(
            String value) {

        try {

            return ZonedDateTime
                    .parse(
                            value,
                            DateTimeFormatter.RFC_1123_DATE_TIME
                    )
                    .toInstant();

        } catch (Exception ignored) {
        }

        return Instant.parse(value);
    }

    // ============================================================
    // DELETE URLS
    // ============================================================

    private static String deletionUrl(
            String service) {

        if (service == null) {
            return "";
        }

        String s =
                service.toLowerCase();

        if (s.contains("amazon")) {
            return "https://www.amazon.com/gp/help/customer/display.html?nodeId=GDK92DNLSGWTV6MP";
        }

        if (s.contains("spotify")) {
            return "https://support.spotify.com/";
        }

        if (s.contains("facebook")) {
            return "https://www.facebook.com/help/delete_account";
        }

        if (s.contains("instagram")) {
            return "https://help.instagram.com/";
        }

        if (s.contains("linkedin")) {
            return "https://www.linkedin.com/help/linkedin/";
        }

        if (s.contains("reddit")) {
            return "https://support.reddithelp.com/";
        }

        if (s.contains("discord")) {
            return "https://support.discord.com/";
        }

        if (s.contains("dropbox")) {
            return "https://help.dropbox.com/";
        }

        if (s.contains("github")) {
            return "https://docs.github.com/en/account-and-profile/";
        }

        if (s.contains("microsoft")) {
            return "https://account.live.com/closeaccount.aspx";
        }

        if (s.contains("paypal")) {
            return "https://www.paypal.com/";
        }

        if (s.contains("netflix")) {
            return "https://help.netflix.com/";
        }

        if (s.contains("canva")) {
            return "https://www.canva.com/help/";
        }

        if (s.contains("zoom")) {
            return "https://support.zoom.com/";
        }

        return "";
    }

    private static String deletionInstructions(
            String service) {

        if (deletionUrl(service).isBlank()) {

            return "Official deletion information was not verified by the assistant. Search the service's official help/privacy page and avoid unofficial deletion links.";
        }

        return "Open the official service page, sign in, locate Account or Privacy settings, review the deletion/data-removal option, confirm the request, and save the confirmation.";
    }

    // ============================================================
    // HELPERS
    // ============================================================

    private static String getConnectedEmail() {

        try {

            Gmail gmail =
                    getGmailService();

            if (gmail == null) {
                return "";
            }

            return gmail.users()
                    .getProfile("me")
                    .execute()
                    .getEmailAddress();

        } catch (Exception e) {

            return "";
        }
    }

    private static String header(
            Message message,
            String name) {

        if (message == null
                || message.getPayload() == null
                || message.getPayload()
                .getHeaders() == null) {

            return "";
        }

        for (MessagePartHeader h :
                message.getPayload().getHeaders()) {

            if (name.equalsIgnoreCase(
                    h.getName()
            )) {

                return h.getValue();
            }
        }

        return "";
    }

    private static boolean containsAny(
            String value,
            String... terms) {

        if (value == null) {
            return false;
        }

        String lower =
                value.toLowerCase();

        for (String term :
                terms) {

            if (lower.contains(
                    term.toLowerCase()
            )) {

                return true;
            }
        }

        return false;
    }

    private static int clamp(
            int value,
            int min,
            int max) {

        return Math.max(
                min,
                Math.min(max, value)
        );
    }

    private static String unavailableIfBlank(
            String value) {

        return value == null
                || value.isBlank()
                ? "UNAVAILABLE"
                : value;
    }

    private static String permissionValue(
            String value) {

        if (value == null
                || value.isBlank()) {

            return "UNAVAILABLE";
        }

        String v =
                value.toUpperCase();

        if (v.equals("GRANTED")
                || v.equals("DENIED")
                || v.equals("LIMITED")
                || v.equals("UNAVAILABLE")) {

            return v;
        }

        return "UNAVAILABLE";
    }

    private static String changeReason(
            int change) {

        if (change > 0) {

            return "Your privacy score improved compared with the previous recorded scan.";
        }

        if (change < 0) {

            return "Your privacy score decreased. Review newly detected accounts, permissions or security signals.";
        }

        return "No score change was recorded.";
    }

    private static int calculateCurrentOverallScore(
            String email)
            throws SQLException {

        int a =
                calculateAccountSecurityScore(email);

        int p =
                calculatePermissionScore(email);

        int e =
                calculateExposureScore(email);

        int u =
                calculateUnusedScore(email);

        int s =
                calculateSecurityScore(email);

        return (
                a + p + e + u + s
        ) / 5;
    }

    private static boolean hasScoreImproved(
            String email)
            throws SQLException {

        String sql = """
            SELECT privacy_score
            FROM privacy_audits
            WHERE email=?
            ORDER BY created_at DESC
            LIMIT 2
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);

            try (ResultSet rs =
                         ps.executeQuery()) {

                if (!rs.next()) {
                    return false;
                }

                int latest =
                        rs.getInt(
                                "privacy_score"
                        );

                if (!rs.next()) {
                    return false;
                }

                int previous =
                        rs.getInt(
                                "privacy_score"
                        );

                return latest > previous;
            }
        }
    }

    private static int queryInt(
            String sql,
            String value)
            throws SQLException {

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, value);

            try (ResultSet rs =
                         ps.executeQuery()) {

                if (rs.next()) {
                    return rs.getInt(1);
                }
            }
        }

        return 0;
    }

    private static String queryDeviceReport(
            String email)
            throws SQLException {

        StringBuilder json =
                new StringBuilder("[");

        String sql = """
            SELECT app_name,package_name,
                   risk_score,risk_level,risk_reason
            FROM device_apps
            WHERE email=?
            ORDER BY risk_score DESC
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);

            try (ResultSet rs =
                         ps.executeQuery()) {

                boolean first = true;

                while (rs.next()) {

                    if (!first) {
                        json.append(",");
                    }

                    first = false;

                    json.append("{")
                            .append("\"app\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "app_name"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"package\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "package_name"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"score\":")
                            .append(
                                    rs.getInt(
                                            "risk_score"
                                    )
                            )
                            .append(",")

                            .append("\"risk\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "risk_level"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"why\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "risk_reason"
                                            )
                                    )
                            )
                            .append("}");
                }
            }
        }

        json.append("]");

        return json.toString();
    }

    private static String quote(
            String value) {

        if (value == null) {
            return "null";
        }

        return "\""
                + jsonEscape(value)
                + "\"";
    }

    private static String jsonEscape(
            String value) {

        if (value == null) {
            return "";
        }

        return value
                .replace("\\", "\\\\")
                .replace("\"", "\\\"")
                .replace("\n", "\\n")
                .replace("\r", "\\r")
                .replace("\t", "\\t");
    }

    private static String jsonError(
            String message) {

        return "{"
                + "\"error\":"
                + quote(
                message == null
                        ? "Unknown error"
                        : message
        )
                + "}";
    }

    private static String htmlEscape(
            String value) {

        if (value == null) {
            return "";
        }

        return value
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;");
    }

    // ============================================================
    // HTTP HELPERS
    // ============================================================

    private static void sendJson(
            HttpExchange exchange,
            int status,
            String body)
            throws IOException {

        addCors(exchange);

        byte[] bytes =
                body.getBytes(
                        StandardCharsets.UTF_8
                );

        exchange.getResponseHeaders()
                .set(
                        "Content-Type",
                        "application/json; charset=UTF-8"
                );

        exchange.sendResponseHeaders(
                status,
                bytes.length
        );

        try (OutputStream os =
                     exchange.getResponseBody()) {

            os.write(bytes);
        }
    }

    private static void sendHtml(
            HttpExchange exchange,
            int status,
            String body)
            throws IOException {

        addCors(exchange);

        byte[] bytes =
                body.getBytes(
                        StandardCharsets.UTF_8
                );

        exchange.getResponseHeaders()
                .set(
                        "Content-Type",
                        "text/html; charset=UTF-8"
                );

        exchange.sendResponseHeaders(
                status,
                bytes.length
        );

        try (OutputStream os =
                     exchange.getResponseBody()) {

            os.write(bytes);
        }
    }

    private static void redirect(
            HttpExchange exchange,
            String url)
            throws IOException {

        addCors(exchange);

        exchange.getResponseHeaders()
                .set(
                        "Location",
                        url
                );

        exchange.sendResponseHeaders(
                302,
                -1
        );

        exchange.close();
    }

    private static void addCors(
            HttpExchange exchange) {

        exchange.getResponseHeaders()
                .set(
                        "Access-Control-Allow-Origin",
                        "*"
                );

        exchange.getResponseHeaders()
                .set(
                        "Access-Control-Allow-Methods",
                        "GET,POST,OPTIONS"
                );

        exchange.getResponseHeaders()
                .set(
                        "Access-Control-Allow-Headers",
                        "Content-Type"
                );
    }

    private static String readBody(
            HttpExchange exchange)
            throws IOException {

        try (InputStream in =
                     exchange.getRequestBody()) {

            return new String(
                    in.readAllBytes(),
                    StandardCharsets.UTF_8
            );
        }
    }

    private static Map<String, String>
    parseForm(
            HttpExchange exchange)
            throws IOException {

        String body =
                readBody(exchange);

        return parseQuery(body);
    }

    private static Map<String, String>
    parseQuery(String query) {

        Map<String, String> map =
                new HashMap<>();

        if (query == null
                || query.isBlank()) {

            return map;
        }

        for (String pair :
                query.split("&")) {

            String[] parts =
                    pair.split(
                            "=",
                            2
                    );

            String key =
                    urlDecode(
                            parts[0]
                    );

            String value =
                    parts.length > 1
                            ? urlDecode(parts[1])
                            : "";

            map.put(key, value);
        }

        return map;
    }

    private static String queryParam(
            HttpExchange exchange,
            String key) {

        return parseQuery(
                exchange.getRequestURI()
                        .getRawQuery()
        ).getOrDefault(
                key,
                ""
        );
    }

    private static String urlDecode(
            String value) {

        try {

            return URLDecoder.decode(
                    value,
                    StandardCharsets.UTF_8
            );

        } catch (Exception e) {

            return value;
        }
    }

    // ============================================================
    // VERY SMALL JSON OBJECT PARSER
    // Used only for simple Flutter device payloads.
    // ============================================================

    private static Map<String, String>
    parseSimpleJsonObject(
            String json) {

        Map<String, String> map =
                new HashMap<>();

        if (json == null) {
            return map;
        }

        Pattern pattern =
                Pattern.compile(
                        "\"([^\"]+)\"\\s*:\\s*"
                                + "(\"(?:\\\\.|[^\"])*\"|true|false|null|-?\\d+(?:\\.\\d+)?)"
                );

        Matcher matcher =
                pattern.matcher(json);

        while (matcher.find()) {

            String key =
                    matcher.group(1);

            String value =
                    matcher.group(2);

            if (value.startsWith("\"")
                    && value.endsWith("\"")) {

                value =
                        value.substring(
                                1,
                                value.length() - 1
                        )
                                .replace(
                                        "\\\"",
                                        "\""
                                )
                                .replace(
                                        "\\n",
                                        "\n"
                                )
                                .replace(
                                        "\\\\",
                                        "\\"
                                );
            }

            map.put(
                    key,
                    value
            );
        }

        return map;
    }


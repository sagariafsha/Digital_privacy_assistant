    private static void accounts(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {

                email =
                        getConnectedEmail();
            }

            if (email.isBlank()) {

                sendJson(
                        exchange,
                        400,
                        jsonError("Email required.")
                );

                return;
            }

            sendJson(
                    exchange,
                    200,
                    getAccountsJson(email)
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static String getAccountsJson(
            String email)
            throws SQLException {

        StringBuilder json =
                new StringBuilder("[");

        String sql = """
            SELECT *
            FROM discovered_accounts
            WHERE email = ?
            ORDER BY risk_score DESC
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);

            try (ResultSet rs =
                         ps.executeQuery()) {

                boolean first = true;

                while (rs.next()) {

                    if (!first) {
                        json.append(",");
                    }

                    first = false;

                    json.append("{")
                            .append("\"id\":")
                            .append(rs.getInt("id"))
                            .append(",")

                            .append("\"service\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "service"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"domain\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "domain"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"evidenceCount\":")
                            .append(
                                    rs.getInt(
                                            "evidence_count"
                                    )
                            )
                            .append(",")

                            .append("\"firstDetected\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "first_detected"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"lastDetected\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "last_detected"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"potentiallyUnused\":")
                            .append(
                                    rs.getBoolean(
                                            "potentially_unused"
                                    )
                            )
                            .append(",")

                            .append("\"securitySignal\":")
                            .append(
                                    rs.getBoolean(
                                            "security_signal"
                                    )
                            )
                            .append(",")

                            .append("\"personalDataSignal\":")
                            .append(
                                    rs.getBoolean(
                                            "personal_data_signal"
                                    )
                            )
                            .append(",")

                            .append("\"riskScore\":")
                            .append(
                                    rs.getInt(
                                            "risk_score"
                                    )
                            )
                            .append(",")

                            .append("\"riskLevel\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "risk_level"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"recommendation\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "recommendation"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"whyRisky\":")
                            .append(
                                    quote(
                                            rs.getString(
                                                    "why_risky"
                                            )
                                    )
                            )
                            .append(",")

                            .append("\"watchlisted\":")
                            .append(
                                    rs.getBoolean(
                                            "watchlisted"
                                    )
                            )

                            .append("}");
                }
            }
        }

        json.append("]");

        return json.toString();
    }


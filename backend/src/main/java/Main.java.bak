    private static void discoverySummary(
            HttpExchange exchange)
            throws IOException {

        try {

            String email =
                    queryParam(
                            exchange,
                            "email"
                    );

            if (email.isBlank()) {
                email = getConnectedEmail();
            }

            String sql = """
                SELECT
                    COUNT(*) total,
                    SUM(risk_level='HIGH') high_count,
                    SUM(risk_level='MEDIUM') medium_count,
                    SUM(risk_level='LOW') low_count,
                    SUM(potentially_unused=1) unused_count,
                    SUM(security_signal=1) security_count,
                    SUM(personal_data_signal=1) personal_count,
                    COALESCE(AVG(risk_score),0) avg_risk
                FROM discovered_accounts
                WHERE email=?
            """;

            try (Connection conn = getConnection();
                 PreparedStatement ps =
                         conn.prepareStatement(sql)) {

                ps.setString(1, email);

                try (ResultSet rs =
                             ps.executeQuery()) {

                    if (rs.next()) {

                        int total =
                                rs.getInt("total");

                        int high =
                                rs.getInt("high_count");

                        int medium =
                                rs.getInt("medium_count");

                        int low =
                                rs.getInt("low_count");

                        int unused =
                                rs.getInt("unused_count");

                        int security =
                                rs.getInt("security_count");

                        int personal =
                                rs.getInt("personal_count");

                        int avgRisk =
                                rs.getInt("avg_risk");

                        int score =
                                clamp(
                                        100 - avgRisk,
                                        0,
                                        100
                                );

                        sendJson(
                                exchange,
                                200,
                                "{"
                                        + "\"email\":"
                                        + quote(email)
                                        + ",\"totalAccounts\":"
                                        + total
                                        + ",\"highRisk\":"
                                        + high
                                        + ",\"mediumRisk\":"
                                        + medium
                                        + ",\"lowRisk\":"
                                        + low
                                        + ",\"unusedAccounts\":"
                                        + unused
                                        + ",\"securitySignals\":"
                                        + security
                                        + ",\"personalDataSignals\":"
                                        + personal
                                        + ",\"privacyScore\":"
                                        + score
                                        + ",\"riskLevel\":"
                                        + quote(
                                        privacyRiskFromPrivacyScore(
                                                score
                                        )
                                )
                                        + "}"
                        );

                        return;
                    }
                }
            }

            sendJson(
                    exchange,
                    200,
                    "{}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // DEVICE SCANNER
    // ============================================================
    /*
     * The Android/Flutter app sends ACTUAL collected data here.
     *
     * Backend never invents:
     * - install dates
     * - permission states
     * - usage dates
     * - notification access
     *
     * Missing values remain "UNAVAILABLE".
     */

    private static void deviceScan(
            HttpExchange exchange)
            throws IOException {

        if (!"POST".equalsIgnoreCase(
                exchange.getRequestMethod())) {

            sendJson(
                    exchange,
                    405,
                    jsonError("POST required.")
            );

            return;
        }

        try {

            String body =
                    readBody(exchange);

            Map<String, String> data =
                    parseSimpleJsonObject(body);

            String email =
                    data.getOrDefault(
                            "email",
                            getConnectedEmail()
                    );

            String packageName =
                    data.getOrDefault(
                            "packageName",
                            ""
                    );

            String appName =
                    data.getOrDefault(
                            "appName",
                            "Unknown App"
                    );

            if (packageName.isBlank()) {

                sendJson(
                        exchange,
                        400,
                        jsonError(
                                "packageName is required."
                        )
                );

                return;
            }

            String versionName =
                    unavailableIfBlank(
                            data.get("versionName")
                    );

            String versionCode =
                    unavailableIfBlank(
                            data.get("versionCode")
                    );

            String installDate =
                    unavailableIfBlank(
                            data.get("installDate")
                    );

            String usageStatus =
                    unavailableIfBlank(
                            data.get("usageStatus")
                    );

            String camera =
                    permissionValue(
                            data.get("camera")
                    );

            String microphone =
                    permissionValue(
                            data.get("microphone")
                    );

            String location =
                    permissionValue(
                            data.get("location")
                    );

            String contacts =
                    permissionValue(
                            data.get("contacts")
                    );

            String storage =
                    permissionValue(
                            data.get("storage")
                    );

            String notification =
                    permissionValue(
                            data.get("notification")
                    );

            int sensitive =
                    countGrantedSensitivePermissions(
                            camera,
                            microphone,
                            location,
                            contacts,
                            storage,
                            notification
                    );

            int risk =
                    calculateAppRisk(
                            camera,
                            microphone,
                            location,
                            contacts,
                            storage,
                            notification,
                            usageStatus
                    );

            String riskLevel =
                    getRiskLevelFromRisk(risk);

            String reason =
                    appRiskExplanation(
                            camera,
                            microphone,
                            location,
                            contacts,
                            storage,
                            notification,
                            usageStatus,
                            risk
                    );

            saveDeviceApp(
                    email,
                    packageName,
                    appName,
                    versionName,
                    versionCode,
                    installDate,
                    usageStatus,
                    camera,
                    microphone,
                    location,
                    contacts,
                    storage,
                    notification,
                    sensitive,
                    risk,
                    riskLevel,
                    reason
            );

            savePermissionSnapshot(
                    email,
                    packageName,
                    appName,
                    "CAMERA",
                    camera
            );

            savePermissionSnapshot(
                    email,
                    packageName,
                    appName,
                    "MICROPHONE",
                    microphone
            );

            savePermissionSnapshot(
                    email,
                    packageName,
                    appName,
                    "LOCATION",
                    location
            );

            savePermissionSnapshot(
                    email,
                    packageName,
                    appName,
                    "CONTACTS",
                    contacts
            );

            savePermissionSnapshot(
                    email,
                    packageName,
                    appName,
                    "STORAGE",
                    storage
            );

            savePermissionSnapshot(
                    email,
                    packageName,
                    appName,
                    "NOTIFICATION",
                    notification
            );

            addTimelineEvent(
                    email,
                    "DEVICE_APP_SCAN",
                    appName,
                    "App permission information scanned from Android.",
                    null,
                    "ANDROID_PERMISSION_DATA"
            );

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"success\":true,"
                            + "\"appName\":"
                            + quote(appName)
                            + ",\"riskScore\":"
                            + risk
                            + ",\"riskLevel\":"
                            + quote(riskLevel)
                            + ",\"riskReason\":"
                            + quote(reason)
                            + ",\"dataSource\":\"ANDROID_PERMISSION_DATA\""
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static void saveDeviceApp(
            String email,
            String packageName,
            String appName,
            String versionName,
            String versionCode,
            String installDate,
            String usageStatus,
            String camera,
            String microphone,
            String location,
            String contacts,
            String storage,
            String notification,
            int sensitive,
            int risk,
            String riskLevel,
            String reason)
            throws SQLException {

        String sql = """
            INSERT INTO device_apps
            (
                email,
                package_name,
                app_name,
                version_name,
                version_code,
                install_date,
                usage_status,
                camera_permission,
                microphone_permission,
                location_permission,
                contacts_permission,
                storage_permission,
                notification_access,
                sensitive_permission_count,
                risk_score,
                risk_level,
                risk_reason,
                data_source
            )
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            ON DUPLICATE KEY UPDATE
                app_name=VALUES(app_name),
                version_name=VALUES(version_name),
                version_code=VALUES(version_code),
                install_date=VALUES(install_date),
                usage_status=VALUES(usage_status),
                camera_permission=VALUES(camera_permission),
                microphone_permission=VALUES(microphone_permission),
                location_permission=VALUES(location_permission),
                contacts_permission=VALUES(contacts_permission),
                storage_permission=VALUES(storage_permission),
                notification_access=VALUES(notification_access),
                sensitive_permission_count=VALUES(sensitive_permission_count),
                risk_score=VALUES(risk_score),
                risk_level=VALUES(risk_level),
                risk_reason=VALUES(risk_reason)
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, packageName);
            ps.setString(3, appName);
            ps.setString(4, versionName);
            ps.setString(5, versionCode);
            ps.setString(6, installDate);
            ps.setString(7, usageStatus);
            ps.setString(8, camera);
            ps.setString(9, microphone);
            ps.setString(10, location);
            ps.setString(11, contacts);
            ps.setString(12, storage);
            ps.setString(13, notification);
            ps.setInt(14, sensitive);
            ps.setInt(15, risk);
            ps.setString(16, riskLevel);
            ps.setString(17, reason);
            ps.setString(
                    18,
                    "ANDROID_PERMISSION_DATA"
            );

            ps.executeUpdate();
        }
    }

    private static void savePermissionSnapshot(
            String email,
            String packageName,
            String appName,
            String permission,
            String state)
            throws SQLException {

        String sql = """
            INSERT INTO permission_snapshots
            (email,package_name,app_name,permission_name,permission_state)
            VALUES (?,?,?,?,?)
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, packageName);
            ps.setString(3, appName);
            ps.setString(4, permission);
            ps.setString(5, state);

            ps.executeUpdate();
        }
    }


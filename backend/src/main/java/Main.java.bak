                                                        "risk_level"
                                                )
                                        )
                                )
                                .append(",")

                                .append("\"totalMessages\":")
                                .append(
                                        rs.getInt(
                                                "total_messages"
                                        )
                                )
                                .append(",")

                                .append("\"securitySignals\":")
                                .append(
                                        rs.getInt(
                                                "security_signals"
                                        )
                                )
                                .append(",")

                                .append("\"personalDataSignals\":")

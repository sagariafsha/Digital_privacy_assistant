    // ============================================================
    // DATABASE
    // ============================================================

    private static Connection getConnection()
            throws SQLException {

        return DriverManager.getConnection(
                DB_URL,
                DB_USER,
                DB_PASSWORD
        );
    }

    private static void createDatabaseTables()
            throws SQLException {

        try (Connection conn = getConnection();
             Statement st = conn.createStatement()) {

            // ----------------------------------------------------
            // EXISTING DISCOVERED ACCOUNTS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS discovered_accounts (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255) NOT NULL,
                    service VARCHAR(255),
                    domain VARCHAR(255),
                    evidence_count INT DEFAULT 0,
                    first_detected VARCHAR(100),
                    last_detected VARCHAR(100),
                    potentially_unused BOOLEAN DEFAULT FALSE,
                    security_signal BOOLEAN DEFAULT FALSE,
                    personal_data_signal BOOLEAN DEFAULT FALSE,
                    risk_score INT DEFAULT 0,
                    risk_level VARCHAR(20),
                    recommendation TEXT,
                    why_risky TEXT,
                    watchlisted BOOLEAN DEFAULT FALSE,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    UNIQUE KEY unique_account(email, domain)
                )
            """);

            // ----------------------------------------------------
            // EXISTING PRIVACY AUDITS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS privacy_audits (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    privacy_score INT,
                    risk_level VARCHAR(20),
                    total_messages INT DEFAULT 0,
                    total_threads INT DEFAULT 0,
                    security_signals INT DEFAULT 0,
                    personal_data_signals INT DEFAULT 0,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """);

            // ----------------------------------------------------
            // DEVICE APPS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS device_apps (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    package_name VARCHAR(255),
                    app_name VARCHAR(255),
                    version_name VARCHAR(100),
                    version_code VARCHAR(100),
                    install_date VARCHAR(100),
                    usage_status VARCHAR(50),
                    camera_permission VARCHAR(30),
                    microphone_permission VARCHAR(30),
                    location_permission VARCHAR(30),
                    contacts_permission VARCHAR(30),
                    storage_permission VARCHAR(30),
                    notification_access VARCHAR(30),
                    sensitive_permission_count INT DEFAULT 0,
                    risk_score INT DEFAULT 0,
                    risk_level VARCHAR(20),
                    risk_reason TEXT,
                    data_source VARCHAR(100),
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    UNIQUE KEY unique_app(email, package_name)
                )
            """);

            // ----------------------------------------------------
            // PERMISSION SNAPSHOTS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS permission_snapshots (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    package_name VARCHAR(255),
                    app_name VARCHAR(255),
                    permission_name VARCHAR(255),
                    permission_state VARCHAR(50),
                    snapshot_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """);

            // ----------------------------------------------------
            // TIMELINE
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS privacy_timeline (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    event_type VARCHAR(100),
                    service VARCHAR(255),
                    description TEXT,
                    event_date VARCHAR(100),
                    source VARCHAR(100),
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """);

            // ----------------------------------------------------
            // DELETION ACTIONS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS privacy_actions (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    service VARCHAR(255),
                    action_type VARCHAR(100),
                    status VARCHAR(50),
                    notes TEXT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                        ON UPDATE CURRENT_TIMESTAMP
                )
            """);

            // ----------------------------------------------------
            // WEBSITE SCANS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS website_checks (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    website VARCHAR(500),
                    https_status VARCHAR(50),
                    certificate_status VARCHAR(100),
                    cookie_indicator VARCHAR(100),
                    third_party_indicator VARCHAR(100),
                    tracker_indicator VARCHAR(100),
                    privacy_risk VARCHAR(30),
                    risk_score INT,
                    explanation TEXT,
                    source VARCHAR(100),
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """);

            // ----------------------------------------------------
            // RECOMMENDATIONS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS recommendations (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    title VARCHAR(255),
                    explanation TEXT,
                    priority VARCHAR(30),
                    status VARCHAR(50) DEFAULT 'PENDING',
                    reason TEXT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """);

            // ----------------------------------------------------
            // WATCHLIST
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS watchlist (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    item_type VARCHAR(50),
                    item_key VARCHAR(255),
                    item_name VARCHAR(255),
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    UNIQUE KEY unique_watch(email, item_type, item_key)
                )
            """);

            // ----------------------------------------------------
            // PRIVACY GOALS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS privacy_goals (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255) UNIQUE,
                    goal_score INT DEFAULT 85,
                    status VARCHAR(50) DEFAULT 'ACTIVE',
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                        ON UPDATE CURRENT_TIMESTAMP
                )
            """);

            // ----------------------------------------------------
            // ACHIEVEMENTS
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS achievements (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255),
                    achievement_key VARCHAR(100),
                    title VARCHAR(255),
                    description TEXT,
                    unlocked BOOLEAN DEFAULT FALSE,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    UNIQUE KEY unique_achievement(email, achievement_key)
                )
            """);

            // ----------------------------------------------------
            // CLEANUP JOURNEY
            // ----------------------------------------------------

            st.execute("""
                CREATE TABLE IF NOT EXISTS cleanup_progress (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    email VARCHAR(255) UNIQUE,
                    step1_accounts BOOLEAN DEFAULT FALSE,
                    step2_permissions BOOLEAN DEFAULT FALSE,
                    step3_exposure BOOLEAN DEFAULT FALSE,
                    step4_websites BOOLEAN DEFAULT FALSE,
                    step5_deletion BOOLEAN DEFAULT FALSE,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                        ON UPDATE CURRENT_TIMESTAMP
                )
            """);
        }

        System.out.println("Database tables ready.");
    }

    // ============================================================
    // GOOGLE OAUTH
    // ============================================================

    private static void setupGoogleOAuth()
            throws Exception {

        File clientFile =
                new File(CLIENT_SECRET_FILE);

        if (!clientFile.exists()) {

            System.err.println(
                    "WARNING: " + CLIENT_SECRET_FILE
                            + " not found."
            );

            return;
        }

        try (InputStream in =
                     new FileInputStream(clientFile)) {

            GoogleClientSecrets clientSecrets =
                    GoogleClientSecrets.load(
                            JSON_FACTORY,
                            new InputStreamReader(
                                    in,
                                    StandardCharsets.UTF_8
                            )
                    );

            googleFlow =
                    new GoogleAuthorizationCodeFlow.Builder(
                            HTTP_TRANSPORT,
                            JSON_FACTORY,
                            clientSecrets,
                            Collections.singletonList(
                                    GMAIL_SCOPE
                            )
                    )
                            .setDataStoreFactory(
                                    new FileDataStoreFactory(
                                            new File(TOKENS_DIRECTORY)
                                    )
                            )
                            .setAccessType("offline")
                            .build();
        }
    }

    private static Credential getCredential()
            throws Exception {

        if (googleFlow == null) {
            return null;
        }

        Credential credential =
                googleFlow.loadCredential("user");

        return credential;
    }

    private static Gmail getGmailService()
            throws Exception {

        Credential credential =
                getCredential();

        if (credential == null) {
            return null;
        }

        return new Gmail.Builder(
                HTTP_TRANSPORT,
                JSON_FACTORY,
                credential
        )
                .setApplicationName(APPLICATION_NAME)
                .build();
    }

    // ============================================================
    // GOOGLE LOGIN
    // ============================================================

    private static void googleLogin(
            HttpExchange exchange)
            throws IOException {

        try {

            if (googleFlow == null) {

                sendHtml(
                        exchange,
                        500,
                        "Google OAuth is not configured."
                );

                return;
            }

            String authorizationUrl =
                    googleFlow.newAuthorizationUrl()
                            .setRedirectUri(REDIRECT_URI)
                            .build();

            redirect(
                    exchange,
                    authorizationUrl
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static void oauthCallback(
            HttpExchange exchange)
            throws IOException {

        try {

            Map<String, String> params =
                    parseQuery(
                            exchange.getRequestURI()
                                    .getRawQuery()
                    );

            String code = params.get("code");

            if (code == null) {

                sendHtml(
                        exchange,
                        400,
                        "Google authorization code missing."
                );

                return;
            }

            if (googleFlow == null) {

                sendHtml(
                        exchange,
                        500,
                        "Google OAuth not configured."
                );

                return;
            }

            googleFlow.newTokenRequest(code)
                    .setRedirectUri(REDIRECT_URI)
                    .executeAndStore(
                            googleFlow
                                    .getDataStoreFactory()
                                    .getDataStore(
                                            "StoredCredential"
                                    ),
                            "user"
                    );

            sendHtml(
                    exchange,
                    200,
                    """
                    <html>
                    <body style="font-family:Arial;text-align:center;padding:40px">
                    <h2>Google connected successfully.</h2>
                    <p>You can return to Digital Privacy Assistant.</p>
                    </body>
                    </html>
                    """
            );

        } catch (Exception e) {

            sendHtml(
                    exchange,
                    500,
                    "OAuth error: " + htmlEscape(e.getMessage())
            );
        }
    }

    private static void googleStatus(
            HttpExchange exchange)
            throws IOException {

        try {

            Gmail gmail =
                    getGmailService();

            if (gmail == null) {

                sendJson(
                        exchange,
                        200,
                        """
                        {
                          "connected":false,
                          "email":""
                        }
                        """
                );

                return;
            }

            Profile profile =
                    gmail.users()
                            .getProfile("me")
                            .execute();

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"connected\":true,"
                            + "\"email\":"
                            + quote(profile.getEmailAddress())
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    200,
                    """
                    {
                      "connected":false,
                      "email":""
                    }
                    """
            );
        }
    }

    // ============================================================
    // GMAIL AUDIT
    // ============================================================

    private static void gmailAudit(
            HttpExchange exchange)
            throws IOException {

        try {

            Gmail gmail =
                    getGmailService();

            if (gmail == null) {
                sendJson(
                        exchange,
                        401,
                        jsonError(
                                "Google account is not connected."
                        )
                );
                return;
            }

            Profile profile =
                    gmail.users()
                            .getProfile("me")
                            .execute();

            long messages =
                    profile.getMessagesTotal() == null
                            ? 0
                            : profile.getMessagesTotal();

            long threads =
                    profile.getThreadsTotal() == null
                            ? 0
                            : profile.getThreadsTotal();

            sendJson(
                    exchange,
                    200,
                    "{"
                            + "\"connected\":true,"
                            + "\"email\":"
                            + quote(
                            profile.getEmailAddress()
                    )
                            + ",\"totalMessages\":"
                            + messages
                            + ",\"totalThreads\":"
                            + threads
                            + "}"
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    // ============================================================
    // EMAIL AUDIT — EXISTING COMPATIBILITY
    // ============================================================

    private static void emailAudit(
            HttpExchange exchange)
            throws IOException {

        gmailAudit(exchange);
    }
        // ============================================================
    // ACCOUNT DISCOVERY
    // ============================================================

    private static void discoverAccountsEndpoint(
            HttpExchange exchange)
            throws IOException {

        if (!"POST".equalsIgnoreCase(
                exchange.getRequestMethod())) {

            sendJson(
                    exchange,
                    405,
                    jsonError("POST required.")
            );

            return;
        }

        try {

            Map<String, String> form =
                    parseForm(exchange);

            String email =
                    form.getOrDefault("email", "")
                            .trim();

            if (email.isBlank()) {

                sendJson(
                        exchange,
                        400,
                        jsonError("Email is required.")
                );

                return;
            }

            DiscoverySummary result =
                    discoverAccounts(email);

            sendJson(
                    exchange,
                    200,
                    result.toJson()
            );

        } catch (Exception e) {

            sendJson(
                    exchange,
                    500,
                    jsonError(e.getMessage())
            );
        }
    }

    private static DiscoverySummary discoverAccounts(
            String email)
            throws Exception {

        Gmail gmail =
                getGmailService();

        if (gmail == null) {
            throw new Exception(
                    "Google account is not connected."
            );
        }

        Profile profile =
                gmail.users()
                        .getProfile("me")
                        .execute();

        String connectedEmail =
                profile.getEmailAddress();

        if (!connectedEmail.equalsIgnoreCase(email)) {

            throw new Exception(
                    "Entered email does not match the authorized Gmail account."
            );
        }

        String query =
                "("
                        + "welcome OR verify OR confirm OR "
                        + "\"account created\" OR registration OR "
                        + "\"password reset\" OR \"security alert\" OR "
                        + "\"new sign-in\" OR \"new login\" OR "
                        + "\"verification code\""
                        + ")";

        List<Message> messages =
                gmail.users()
                        .messages()
                        .list("me")
                        .setQ(query)
                        .setMaxResults(
                                (long) MAX_GMAIL_MESSAGES
                        )
                        .execute()
                        .getMessages();

        if (messages == null) {
            messages = new ArrayList<>();
        }

        Map<String, ServiceSignal> detected =
                new HashMap<>();

        for (Message message : messages) {

            Message metadata =
                    gmail.users()
                            .messages()
                            .get(
                                    "me",
                                    message.getId()
                            )
                            .setFormat("metadata")
                            .setMetadataHeaders(
                                    Arrays.asList(
                                            "From",
                                            "Subject",
                                            "Date"
                                    )
                            )
                            .execute();

            String from =
                    header(
                            metadata,
                            "From"
                    );

            String subject =
                    header(
                            metadata,
                            "Subject"
                    );

            String date =
                    header(
                            metadata,
                            "Date"
                    );

            String domain =
                    extractDomain(from);

            if (domain.isBlank()
                    || isGenericDomain(domain)) {

                continue;
            }

            String service =
                    identifyService(domain);

            ServiceSignal signal =
                    detected.computeIfAbsent(
                            domain,
                            d -> new ServiceSignal(
                                    service,
                                    d
                            )
                    );

            signal.evidenceCount++;

            if (date != null && !date.isBlank()) {

                if (signal.firstDetected == null
                        || date.compareTo(
                        signal.firstDetected
                ) < 0) {

                    signal.firstDetected = date;
                }

                if (signal.lastDetected == null
                        || date.compareTo(
                        signal.lastDetected
                ) > 0) {

                    signal.lastDetected = date;
                }
            }

            String combined =
                    (
                            subject + " " + from
                    ).toLowerCase();

            if (containsAny(
                    combined,
                    "security alert",
                    "new sign-in",
                    "new login",
                    "password reset",
                    "verification code",
                    "suspicious login"
            )) {

                signal.securitySignal = true;
            }

            if (containsAny(
                    combined,
                    "address",
                    "phone",
                    "mobile",
                    "shipping",
                    "delivery",
                    "profile",
                    "personal information"
            )) {

                signal.personalDataSignal = true;
            }
        }

        int totalHigh = 0;
        int totalMedium = 0;
        int totalLow = 0;
        int unused = 0;

        for (ServiceSignal signal :
                detected.values()) {

            signal.potentiallyUnused =
                    isPotentiallyUnused(
                            signal.lastDetected
                    );

            if (signal.potentiallyUnused) {
                unused++;
            }

            signal.riskScore =
                    calculateAccountRisk(signal);

            signal.riskLevel =
                    getRiskLevelFromRisk(
                            signal.riskScore
                    );

            signal.whyRisky =
                    accountRiskExplanation(
                            signal
                    );

            signal.recommendation =
                    accountRecommendation(
                            signal
                    );

            if ("HIGH".equals(signal.riskLevel)) {
                totalHigh++;
            } else if ("MEDIUM".equals(signal.riskLevel)) {
                totalMedium++;
            } else {
                totalLow++;
            }

            saveDiscoveredAccount(
                    email,
                    signal
            );

            addTimelineEvent(
                    email,
                    "ACCOUNT_DISCOVERY",
                    signal.service,
                    "Possible account detected from authorized Gmail evidence.",
                    signal.lastDetected,
                    "AUTHORIZED_GMAIL"
            );
        }

        int privacyScore =
                calculatePrivacyScore(
                        detected.values()
                );

        String riskLevel =
                privacyRiskFromPrivacyScore(
                        privacyScore
                );

        int securitySignals = 0;
        int personalSignals = 0;

        for (ServiceSignal s :
                detected.values()) {

            if (s.securitySignal) {
                securitySignals++;
            }

            if (s.personalDataSignal) {
                personalSignals++;
            }
        }

        savePrivacyAudit(
                email,
                privacyScore,
                riskLevel,
                messages.size(),
                securitySignals,
                personalSignals
        );

        updateAchievementsAfterScan(
                email,
                privacyScore
        );

        return new DiscoverySummary(
                email,
                detected.size(),
                totalHigh,
                totalMedium,
                totalLow,
                unused,
                securitySignals,
                personalSignals,
                privacyScore,
                riskLevel
        );
    }

    private static void saveDiscoveredAccount(
            String email,
            ServiceSignal signal)
            throws SQLException {

        String sql = """
            INSERT INTO discovered_accounts
            (
                email,
                service,
                domain,
                evidence_count,
                first_detected,
                last_detected,
                potentially_unused,
                security_signal,
                personal_data_signal,
                risk_score,
                risk_level,
                recommendation,
                why_risky
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON DUPLICATE KEY UPDATE
                service = VALUES(service),
                evidence_count = VALUES(evidence_count),
                first_detected = VALUES(first_detected),
                last_detected = VALUES(last_detected),
                potentially_unused = VALUES(potentially_unused),
                security_signal = VALUES(security_signal),
                personal_data_signal = VALUES(personal_data_signal),
                risk_score = VALUES(risk_score),
                risk_level = VALUES(risk_level),
                recommendation = VALUES(recommendation),
                why_risky = VALUES(why_risky)
        """;

        try (Connection conn = getConnection();
             PreparedStatement ps =
                     conn.prepareStatement(sql)) {

            ps.setString(1, email);
            ps.setString(2, signal.service);
            ps.setString(3, signal.domain);
            ps.setInt(4, signal.evidenceCount);
            ps.setString(5, signal.firstDetected);
            ps.setString(6, signal.lastDetected);
            ps.setBoolean(7, signal.potentiallyUnused);
            ps.setBoolean(8, signal.securitySignal);
            ps.setBoolean(9, signal.personalDataSignal);
            ps.setInt(10, signal.riskScore);
            ps.setString(11, signal.riskLevel);
            ps.setString(12, signal.recommendation);
            ps.setString(13, signal.whyRisky);

            ps.executeUpdate();
        }
    }

